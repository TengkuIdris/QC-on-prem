DEBUG_MODE=false

PYTHONPATH=${PYTHONPATH}:${workspaceFolder}

# Environment Configuration
ENVIRONMENT=development

LANGSMITH_TRACING=true
LANGSMITH_API_KEY=[YOUR_LANGSMITH_API_KEY]
LANGSMITH_PROJECT=why-why-chat-ai
#LANGCHAIN_TEST_TRACKING=false

# Database Connection Settings
DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/why_why_chat_ai
DATABASE_MIN_CONNECTIONS=1
DATABASE_MAX_CONNECTIONS=10
DATABASE_POOL_TIMEOUT=30
DATABASE_CONNECT_TIMEOUT=30

# Logging
LOG_LEVEL=INFO

# Agent Settings
AGENT_MAX_ITERATIONS=10

# FastAPI
FASTAPI_HOST=0.0.0.0
FASTAPI_PORT=8000

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60

# API Security Settings

## API Key Authentication
# JSON array of valid API keys
SECURITY_API_KEYS='["your-api-key-1","your-api-key-2"]'

## JWT Authentication
# JWT signature algorithm (RS256, HS256, etc.)
SECURITY_JWT_ALGORITHM=RS256

# JWT issuer (optional, used for validation)
SECURITY_JWT_ISSUER=your-issuer

# JWT audience (optional, used for validation)
SECURITY_JWT_AUDIENCE=your-audience

# JWKS URL for fetching public keys (optional)
# SECURITY_JWKS_URL=https://your-auth-provider.com/.well-known/jwks.json

# Public key for JWT validation (PEM format, optional if using JWKS)
# SECURITY_JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----
# MIIBIjANBgkqhkiG9w0BAQEFAAOCAQ8AMIIBCgKCAQEA...
# -----END PUBLIC KEY-----"

## IP Whitelist
# JSON array of allowed IP addresses (empty = allow all)
SECURITY_IP_WHITELIST='[]'

## Rate Limiting
# Default rate limit (format: number/period, e.g., 100/hour, 10/minute)
SECURITY_RATE_LIMIT_DEFAULT=100/hour

# Per-endpoint rate limits (JSON format)
# SECURITY_RATE_LIMIT_PER_ENDPOINT='{"POST /v1/threads": "10/minute", "GET /v1/threads/{thread_id}": "60/minute"}'

# Google Cloud Platform Settings
GCP_PROJECT_ID=your-gcp-project-id
GCP_LOCATION=us-central1
VERTEXAI_STAGING_BUCKET=gs://your-project-id-vertex-ai-staging

# Cloud SQL Settings
CLOUD_SQL_REGION=us-central1
CLOUD_SQL_INSTANCE=why-why-chat-ai-db-dev
CLOUD_SQL_DATABASE=why_why_chat_ai

# Postgres Password Management (Phase 1: Secret Manager)
# For local development, you can set this directly. 
# In production, this will be retrieved from Secret Manager
# POSTGRES_PASSWORD=your_dev_password

# Workspace/Environment (used for Secret Manager secret name)
# WORKSPACE=dev  # or 'prod'

# Cloud SQL Hybrid Authentication Settings (Phase 2)
# Authentication type: "password" | "iam" | "hybrid"
CLOUD_SQL_AUTH_TYPE=hybrid
# IAM user for application authentication (format: service-account@project.iam)
CLOUD_SQL_IAM_USER=app-sa-dev@your-project-id.iam
# Whether to use IAM authentication for the application (when auth_type is hybrid)
CLOUD_SQL_USE_IAM_AUTH=true
# Initialization mode flag (set to true only during database initialization)
INIT_MODE=false

# OpenTelemetry Settings
OTEL_SDK_DISABLED=false
OTEL_TRACE_SAMPLING_RATE=0.1

# ============================================================================
# LLM Provider (on-prem migration)
# ============================================================================
# 'vertex' (default, existing GCP path) or 'local' (OpenAI-compatible endpoint
# such as vLLM / Ollama / TGI). See IMPLEMENTATION_SPEC.md Part A C1.
LLM_PROVIDER=vertex

# Only required when LLM_PROVIDER=local
# LLM_BASE_URL=http://llm:8000/v1
# LLM_MODEL=qwen2.5-32b-instruct
# LLM_API_KEY=not-needed
LLM_TIMEOUT=120
LLM_MAX_RETRIES=2

# ============================================================================
# RAG service (external; see IMPLEMENTATION_SPEC.md Part A C2)
# ============================================================================
# When RAG_ENABLED=true, the agent calls POST {RAG_SERVICE_URL}/retrieve before
# the why-why loop. ANY failure (timeout / non-200 / malformed) is non-fatal —
# the analysis continues with empty retrieved_context.
RAG_ENABLED=false
# RAG_SERVICE_URL=http://rag:8000
RAG_TIMEOUT=30
RAG_TOP_K_CASES=3
RAG_TOP_K_MANUALS=2
