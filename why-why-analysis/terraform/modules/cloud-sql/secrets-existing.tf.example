# Alternative approach: Use existing secret from Secret Manager
# Rename this file to secrets.tf if you want to use an existing secret

# Reference existing secret
data "google_secret_manager_secret_version" "postgres_password_existing" {
  secret  = "postgres-password"
  project = var.project_id
}

# Update the postgres user to use the secret value
resource "google_sql_user" "postgres_from_secret" {
  name     = "postgres"
  instance = google_sql_database_instance.postgres_instance.name
  password = data.google_secret_manager_secret_version.postgres_password_existing.secret_data
  project  = var.project_id
}

# Comment out or remove the random_password resource in main.tf
# and the original google_sql_user.postgres resource