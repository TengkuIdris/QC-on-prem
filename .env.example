# Root .env for the top-level docker-compose.
# Copy to .env and fill in the values before running `docker compose up`.

# ── Required ──────────────────────────────────────────────────────────────────

# Shared postgres password (used by both DBs: Jatco_Postgres and why_why_chat_ai)
POSTGRES_PASSWORD=change_me

# Shared secret between NestJS backend and the Python agent (x-api-key header)
AI_SERVICE_API_KEY=change_me

# Local LLM — OpenAI-compatible endpoint (e.g. Ollama, vLLM)
# For Ollama running on the host:  http://host.docker.internal:11434/v1
LLM_BASE_URL=http://host.docker.internal:11434/v1
LLM_MODEL=qwen2.5-32b-instruct
# Set to "not-needed" if your LLM endpoint requires no auth
LLM_API_KEY=not-needed

# ── Optional overrides ────────────────────────────────────────────────────────

# MinIO credentials (defaults shown — change for anything exposed externally)
# MINIO_ROOT_USER=minio-admin
# MINIO_ROOT_PASSWORD=minio-admin-password
# S3_BUCKET_NAME=monozukuri-uploads
# S3_PUBLIC_URL=http://localhost:9000

# RAG service (disabled by default; set RAG_ENABLED=true and provide the URL
# once a RAG service is running)
# RAG_ENABLED=false
# RAG_SERVICE_URL=http://host.docker.internal:8001

# LLM call timeout in seconds (default 120)
# LLM_TIMEOUT=120

# Auth — set both to false (and provide AWS Cognito vars) to re-enable
DISABLE_AUTH=true
VITE_DISABLE_AUTH=true
