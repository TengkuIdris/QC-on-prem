NODE_ENV= development
APP_PORT=3001
APP_PREFIX=/api/v1
APP_NAME=JATCO_BE
APP_KEY_SECRET=rTmFHJTWqc1fX61BxCCH

#Postgres config

POSTGRES_TYPE=postgres
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433
POSTGRES_DB=Jatco_Postgres
POSTGRES_USER=user
POSTGRES_PASSWORD=password

# Redis config
REDIS_PORT=6390
REDIS_HOST=127.0.0.1
REDIS_CONTAINER_NAME=Jatco_Redis
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}?schema=public

# AWS CONFIG
AWS_CONFIG_ACCESS_KEY_ID=
AWS_CONFIG_SECRET_ACCESS_KEY=
AWS_PROJECT_REGION=
AWS_COGNITO_REGION=
AWS_USER_POOLS_ID=
AWS_USER_POOLS_WEB_CLIENT_ID=

# AWS SES CONFIG

AWS_SES_EMAIL_FROM=
AWS_SES_EMAIL_TO=

# Internal API (for F2 broadcast)
INTERNAL_API_KEY=your-internal-api-key

# ============================================================================
# AI Service (why-why analysis agent)
# ============================================================================
# Base URL of the on-prem why-why analysis agent. In docker-compose this is
# the agent container, e.g. http://api:8000. When unset, AiService falls back
# to mock streaming data (see src/services/ai.service.ts).
AI_SERVICE_URL=http://api:8000
# API key for the agent. Required by the agent's x-api-key auth. Keep this in
# env / Secret Manager — NEVER commit. (The legacy ai-service-config.json
# contained a Google Cloud API key; that file is now deprecated.)
AI_SERVICE_API_KEY=