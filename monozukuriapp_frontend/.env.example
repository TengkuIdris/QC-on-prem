# KaizenHub Environment Variables
# Copy this file to .env and fill in your actual values

# AWS Cognito Configuration
# Required for user authentication
# Get these values from your AWS Cognito User Pool settings
VITE_USER_POOL_ID=your_user_pool_id_here
VITE_USER_POOL_CLIENT_ID=your_user_pool_client_id_here

# Optional: API Configuration
# Uncomment and configure if you have additional API endpoints
# VITE_API_BASE_URL=https://your-api-endpoint.com/api

# Optional: Feature Flags
# Uncomment to enable/disable specific features
# VITE_ENABLE_MOCK_SERVER=true
# VITE_ENABLE_ANALYTICS=false

# Optional: Development Configuration
# Uncomment for development-specific settings
# VITE_DEBUG_MODE=true
# VITE_LOG_LEVEL=debug
