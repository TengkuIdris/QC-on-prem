# KaizenHub Frontend Environment Variables
# Copy this file to .env and fill in your values.
#
# On-prem (docker-compose) usage:
#   VITE_DISABLE_AUTH and VITE_BACKEND_URL_V1 are baked in at BUILD time via
#   Docker build-args (see Dockerfile ARG declarations).  You do NOT need a .env
#   file in the container — set them in the root docker-compose .env instead.
#
# Local dev server (npm run dev):
#   Copy this file to .env and set the values below.

# ── On-prem / local dev ───────────────────────────────────────────────────────

# Set to true to bypass AWS Cognito and inject a synthetic admin user.
# Must match DISABLE_AUTH=true on the NestJS backend.
VITE_DISABLE_AUTH=true

# Base URL of the NestJS API as seen from the browser.
# With the nginx reverse proxy in docker-compose this should stay as /api/v1.
VITE_BACKEND_URL_V1=/api/v1

# ── AWS Cognito (only needed when VITE_DISABLE_AUTH=false) ───────────────────
# VITE_USER_POOL_ID=your_user_pool_id_here
# VITE_USER_POOL_CLIENT_ID=your_user_pool_client_id_here
